{
  "manifest_version": 3,
  "name": "WorkWall",
  "version": "0.2.2",
  "description": "Blocks distracting sites during work hours and shows where your time goes.",
  "homepage_url": "https://github.com/natgurlain/workwall",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs", "idle", "favicon"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WorkWall",
    "default_icon": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png" }
  },
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png" },
  "options_page": "options.html",
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }]
}
